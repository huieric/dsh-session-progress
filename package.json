{
  "name": "dsh-session-progress",
  "version": "0.1.0",
  "description": "Show the last few lines of progress (thinking, commands, output, replies) inside the DSH sidebar session hover card.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hover-card",
    "session-progress"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huieric/dsh-session-progress.git"
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "^19.3.1"
  }
}
